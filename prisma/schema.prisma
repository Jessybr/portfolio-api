// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
    id       Int    @id @default(autoincrement())
    username String @unique
    password String
}

model Perfil {
    id           Int    @id @default(autoincrement())
    nomeCompleto      String? 
    email             String 
    celular           String 
    linkedinUrl       String?
    githubUrl         String?
    curriculoSrc      String?
    curriculoPublicId String?
    fotoSrc           String?
    fotoPublicId      String?
}

model Project {
    id             Int     @id @default(autoincrement())
    nome           String
    descricao      String
    ativo          Boolean @default(true)
    videoSrc       String? 
    videoPublicId  String?
    imagemSrc      String? 
    imagemPublicId String?
    deployUrl      String? 
    githubUrl      String? 

    tecnologias Technology_Project[]
    categorias  Category_Project[]
}

model Technology {
    id       Int    @id @default(autoincrement())
    nome     String 
    iconeSrc String 

    projetos Technology_Project[]
}

model Category {
    id       Int    @id @default(autoincrement())
    nome     String 

    projetos Category_Project[]
}

model Technology_Project {
    tecnologia_id Int
    projeto_id    Int

    tecnologia    Technology @relation(fields: [tecnologia_id], references: [id])
    projeto       Project    @relation(fields: [projeto_id], references: [id])

    @@id([tecnologia_id, projeto_id])
}

model Category_Project {
    categoria_id Int
    projeto_id   Int

    categoria    Category @relation(fields: [categoria_id], references: [id])
    projeto      Project  @relation(fields: [projeto_id], references: [id])

    @@id([categoria_id, projeto_id])
}

model SoftSkill {
    id       Int    @id @default(autoincrement())
    nome     String
    iconeSrc String?
}